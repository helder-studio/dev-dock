{
  "name": "@helder-studio/dev-dock",
  "version": "0.0.0",
  "description": "One floating dev panel for React Native QA builds. network-chaos, timewarp and your own tools plug in as tabs.",
  "keywords": [
    "react-native",
    "dev-tools",
    "debug-menu",
    "qa",
    "panel",
    "floating-button"
  ],
  "license": "MIT",
  "author": "helder-studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helder-studio/dev-dock.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./noop": {
      "import": {
        "types": "./dist/noop.d.ts",
        "default": "./dist/noop.js"
      },
      "require": {
        "types": "./dist/noop.d.cts",
        "default": "./dist/noop.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check:pkg": "publint && attw --pack . --profile node16",
    "size": "size-limit",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:pkg && pnpm size",
    "changeset": "changeset",
    "release": "node scripts/publish.mjs",
    "coverage": "vitest run --coverage --coverage.include=src/**"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "3 kB",
      "ignore": [
        "react",
        "react-native"
      ]
    }
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@11.5.2",
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.76"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^3.0.3",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^21.0.4",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "0.88.1",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
